DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=multicatalogo

# Redis (caché). Opcional: si defines REDIS_URL tiene prioridad sobre host/puerto.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# JWT: secreto para firmar tokens (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=clave-secreta-multicatalogo-cambiar-en-produccion

# Solo para demostraciones en clase (dejar vacío en uso normal):
#   items = error forzado después de insertar el pedido (demuestra ROLLBACK)
#   pausa = pausa de 10 s antes del COMMIT (para ejecutar `docker kill multicatalogo-db`)
CHECKOUT_FALLA_SIMULADA=

# Entorno: "dev" muestra "details" en los errores de la API; cualquier otro valor (o vacío) los oculta.
APP_ENV=dev
